<?xml version="1.0" encoding="utf-8"?>
<!-- activity_search.xml — pantalla de búsqueda (título o ISBN, según extra "search_mode") -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_neutral_100"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/text_primary"
                android:contentDescription="Volver" />

            <TextView
                android:id="@+id/textViewSearchTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/caprasimo"
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                tools:text="Buscar por título" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:textSize="12sp"
            android:textColor="@color/neutral_700"
            android:id="@+id/textViewSearchLabel"
            tools:text="Título del libro" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxBackgroundColor="@color/surface"
            app:boxStrokeWidth="0dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextQuery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/neutral_600"
                tools:hint="Ej. Cien años de soledad" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Buscar"
            android:textAllCaps="false"
            android:fontFamily="@font/caprasimo"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            app:backgroundTint="@color/accent"
            app:cornerRadius="16dp" />

        <ProgressBar
            android:id="@+id/progressSearching"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:indeterminateTint="@color/accent"
            tools:visibility="visible" />

        <!-- Tarjeta de resultado -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/white"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textViewResultCoverInitial"
                        android:layout_width="70dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/book_placeholder_background"
                        android:fontFamily="@font/caprasimo"
                        android:textSize="24sp"
                        android:textColor="@color/accent_800"
                        android:gravity="center"
                        tools:text="F" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewResultTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            tools:text="Fahrenheit 451" />

                        <TextView
                            android:id="@+id/textViewResultAuthor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="13sp"
                            android:textColor="@color/accent_700"
                            tools:text="Ray Bradbury" />

                        <TextView
                            android:id="@+id/textViewResultMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textSize="12sp"
                            android:textColor="@color/neutral_700"
                            tools:text="Ballantine Books · 1953" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/textViewResultDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="@color/text_primary"
                    tools:text="En un futuro donde los libros están prohibidos…" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSaveResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Guardar en mi biblioteca"
                    android:textAllCaps="false"
                    android:fontFamily="@font/caprasimo"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    app:backgroundTint="@color/accent"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sin resultados -->
        <TextView
            android:id="@+id/textViewNotFound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="20dp"
            android:background="@drawable/rounded_card_background"
            android:gravity="center"
            android:text="No se encontró ningún libro con esos datos. Prueba con otro título o ISBN."
            android:textSize="13sp"
            android:textColor="@color/neutral_700"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
