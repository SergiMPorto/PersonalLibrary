<?xml version="1.0" encoding="utf-8"?>

<!-- Tarjeta de libro guardado -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Portada (placeholder de color + inicial mientras no haya imagen real) -->
        <TextView
            android:id="@+id/textViewCoverInitial"
            android:layout_width="56dp"
            android:layout_height="80dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/book_placeholder_background"
            android:fontFamily="@font/caprasimo"
            android:textColor="@color/accent_800"
            android:textSize="20sp"
            android:gravity="center"
            tools:text="C" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Cien años de soledad" />

            <TextView
                android:id="@+id/textViewAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="@color/accent_700"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Gabriel García Márquez" />

            <TextView
                android:id="@+id/textViewMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/neutral_700"
                tools:text="Sudamericana · 432 pág." />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/neutral_700"
            android:contentDescription="Ver detalle" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>